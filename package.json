{
  "name": "blacksentinel-vision",
  "version": "1.0.0",
  "description": "BlackSentinel Vision - Autonomous Cyber Threat Intelligence Platform",
  "private": true,
  "author": "BlackSentinel",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start -p 3000",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t blacksentinel-vision:latest .",
    "docker:run": "docker run -p 3000:3000 blacksentinel-vision:latest",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:vercel": "vercel --prod",
    "deploy:aws": "aws ecr get-login-password | docker login --username AWS --password-stdin && docker build -t bsv . && docker push bsv",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.185.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.0",
    "graphology": "^0.26.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
