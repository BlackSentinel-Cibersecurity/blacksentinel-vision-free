# BlackSentinel Vision — environment template
# Run ./scripts/init-env.sh to create .env and fill the blanks below with
# fresh random values. Nothing here ships with a usable default secret.

# Operator (admin) password and session-signing secret. No built-in defaults:
# without ADMIN_PASSWORD, sign-in stays off.
ADMIN_PASSWORD=
JWT_SECRET=

# Password for the OPTIONAL bundled PostgreSQL in docker-compose.yml
# (bound to 127.0.0.1). init-env.sh fills it. The app runs without it.
DB_PASSWORD=

# Optional: point the UI at your own API / WebSocket endpoints.
# BSV_API_URL=https://api.blacksentinel.com
# BSV_WS_URL=wss://ws.blacksentinel.com
# BSV_ENV=production
